{
  "name": "classroom-library",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "prevercel-build": "node scripts/prepare-assets.mjs",
    "vercel-build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "icons": "node scripts/build-icons.mjs",
    "postinstall": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@material/material-color-utilities": "^0.4.0",
    "@vercel/functions": "^3.9.8",
    "barcode-detector": "^3.2.2",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@material-symbols/svg-400": "^0.47.3",
    "@next/env": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
