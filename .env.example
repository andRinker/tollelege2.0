# Copy to .env.local for local development. Every value is optional locally
# except BETTER_AUTH_SECRET.

# --- Database ---
# Leave DATABASE_URL unset locally: the app uses PGlite, stored in .data/pglite.
# On Vercel, set it to your Neon connection string.
DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite   # or memory:// for a throwaway database

# --- Auth (Better Auth) ---
# Generate with: npx auth secret
BETTER_AUTH_SECRET=
# The app's public URL. On Vercel previews this falls back to VERCEL_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Google sign-in (optional) ---
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Password-reset email (required in production) ---
RESEND_API_KEY=
EMAIL_FROM="Tolle Lege <no-reply@example.com>"

# --- Book lookups (optional) ---
# Contact info sent to Open Library in the User-Agent header, e.g. an email address.
OPENLIBRARY_CONTACT=
# Enables Google Books as a fallback source.
GOOGLE_BOOKS_API_KEY=
