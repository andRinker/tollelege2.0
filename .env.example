# Copy to .env.local for local development. Every value is optional locally
# except BETTER_AUTH_SECRET.

# --- Database ---
# Leave DATABASE_URL unset locally: the app uses PGlite, stored in .data/pglite.
# On Vercel, set it to your Neon connection string.
DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite   # or memory:// for a throwaway database

# --- Auth (Better Auth) ---
# Generate with: npx auth secret
BETTER_AUTH_SECRET=
# The app's public URL. Leave it unset on Vercel: production uses the project's production
# domain and previews use their deployment URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Google sign-in (optional) ---
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google and
# https://<production domain>/api/auth/callback/google (previews use email sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Password-reset email (required in production) ---
RESEND_API_KEY=
EMAIL_FROM="Tolle Lege <no-reply@example.com>"

# --- Privacy page (optional) ---
# Where teachers can ask about their data or request account deletion. Shown on /privacy.
SUPPORT_EMAIL=

# --- Administration (optional) ---
# Comma-separated emails of site administrators, who get /admin: every account's usage, a
# read-only look inside any account, acting as a teacher to edit their library, signing an
# account out everywhere and deleting it. Only counts for a verified email (Google sign-in).
ADMIN_EMAILS=

# --- Book lookups (optional) ---
# Contact info sent to Open Library in the User-Agent header, e.g. an email address.
OPENLIBRARY_CONTACT=
# Enables Google Books as a second source. Without it, only Open Library is used.
GOOGLE_BOOKS_API_KEY=

# --- Shelf photos (optional) ---
# Enables "Photograph a shelf" on the Add books screen: a photo is read by Gemini and
# every book it finds is proposed for the teacher to confirm. Without this key the
# feature reports itself as unavailable and the rest of the app is unaffected. Free key
# from https://aistudio.google.com. Photos are sent to Google and never stored.
GEMINI_API_KEY=
# Optional: pin a specific model. Defaults to gemini-flash-latest.
GEMINI_MODEL=
